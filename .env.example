# Copy to .env and fill in. Never commit .env.

# ── Robot arm (fully local: Vosk speech + Laya decisions, no keys) ───────────
# true = the Pi mic drives the robot arm instead of recording meetings
ROBOT_MODE=false
# sim (on-screen only) or pca9685 (real servos over I2C)
ARM_DRIVER=sim
ARM_CHANNELS=base:0,shoulder:1,elbow:2,claw:3
ARM_PULSE_US=500,2500
ARM_TRIM=
ARM_INVERT=
ARM_MIN_CONFIDENCE=0.45

# ── Speech-to-text (Sarvam) ──────────────────────────────────────────────────
SARVAM_API_KEY=
# realtime (default) or chunked (REST backup mode)
STT_BACKEND=realtime
SARVAM_REALTIME_LANGUAGE=hi-IN
SARVAM_STT_MODE=codemix

# ── LLM (OpenRouter or any OpenAI-compatible endpoint) ───────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.1-flash-lite

# ── Microsoft Teams (optional) ───────────────────────────────────────────────
# Either a webhook, or teams-mcp in mcp.json with a chat/channel target.
TEAMS_WEBHOOK_URL=
TEAMS_CHAT_ID=

# ── Azure DevOps (optional) ──────────────────────────────────────────────────
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# ── Microphone ───────────────────────────────────────────────────────────────
# Empty = default ALSA device from asoundrc
RECORD_DEVICE_INDEX=
WAKEWORD_THRESHOLD=0.5
